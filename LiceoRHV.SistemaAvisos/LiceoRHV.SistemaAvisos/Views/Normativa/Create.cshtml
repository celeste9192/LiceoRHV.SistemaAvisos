@{
    ViewData["Title"] = "Nueva Normativa";
}

<div class="pagina-listado">
    <div class="encabezado-listado">
        <div>
            <h2>Nueva Normativa</h2>
            <p>Subí un documento de normativa interna.</p>
        </div>
    </div>

    @if (ViewBag.ErrorNormativa != null)
    {
        <p class="mensaje-error">@ViewBag.ErrorNormativa</p>
    }

    <div class="tarjeta-listado" style="padding:24px;">
        <form method="post" asp-action="Create" enctype="multipart/form-data">
            <div class="campo">
                <label for="Titulo">Título</label>
                <input type="text" id="Titulo" name="Titulo" required />
            </div>

            <div class="campo">
                <label for="Descripcion">Descripción (opcional)</label>
                <textarea id="Descripcion" name="Descripcion" rows="3"
                          style="width:100%; padding:10px 12px; border:1px solid #DCE5DD; border-radius:8px; font-size:14px; font-family:inherit;"></textarea>
            </div>

            <div class="campo">
                <label for="archivo">Archivo (PDF o Word)</label>
                <input type="file" id="archivo" name="archivo" accept=".pdf,.doc,.docx" required />
            </div>

            <div class="detalle-footer">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Cancelar</a>
                <button type="submit" class="btn-guardar-usuario">Publicar</button>
            </div>
        </form>
    </div>
</div>